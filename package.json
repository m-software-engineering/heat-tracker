{
  "name": "heat-tracker",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "build": "corepack pnpm -r build",
    "dev": "corepack pnpm -r dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "corepack pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "corepack pnpm test:unit && corepack pnpm test:e2e",
    "test:unit": "corepack pnpm -r test",
    "test:coverage": "corepack pnpm -r test:coverage",
    "test:e2e": "corepack pnpm -C packages/heat-sdk build && corepack pnpm exec playwright test",
    "check:deps": "knip",
    "check:arch": "depcruise --config .dependency-cruiser.cjs packages examples e2e",
    "check:pkg": "corepack pnpm -r build && corepack pnpm -r --if-present pack:check",
    "api:check": "corepack pnpm -r --if-present api:check",
    "verify": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm build && corepack pnpm test:coverage && corepack pnpm test:e2e && corepack pnpm check:deps && corepack pnpm check:arch && corepack pnpm check:pkg",
    "verify:non-e2e": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm build && corepack pnpm test:coverage && corepack pnpm check:deps && corepack pnpm check:arch && corepack pnpm check:pkg",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@changesets/cli": "^2.27.7",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.58.9",
    "@playwright/test": "^1.51.0",
    "better-sqlite3": "^11.5.0",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^10.5.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-security": "^4.0.1",
    "express": "^4.22.2",
    "globals": "^17.6.0",
    "knip": "^6.17.1",
    "prettier": "^3.8.4",
    "publint": "^0.3.21",
    "tsup": "^8.3.6",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.61.1"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@>=1.0.0 <1.1.18": "1.1.18",
      "brace-expansion@>=5.0.0 <5.0.9": "5.0.9",
      "fast-uri@>=3.0.0 <3.1.6": "3.1.6",
      "flatted@>=3.0.0 <3.4.2": "3.4.2",
      "form-data@>=4.0.0 <4.0.6": "4.0.6",
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "js-yaml@>=3.0.0 <3.15.2": "3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "minimatch@>=3.0.0 <3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "minimatch@>=10.0.0 <10.2.3": "10.2.3",
      "path-to-regexp@>=0.1.0 <0.1.13": "0.1.13",
      "picomatch@>=2.0.0 <2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "postcss@>=8.0.0 <8.5.23": "8.5.23",
      "qs@>=6.0.0 <6.16.0": "6.16.0",
      "rollup@>=4.0.0 <4.59.0": "4.59.0",
      "smol-toml@>=1.0.0 <1.7.1": "1.7.1",
      "vitest@4.1.11>vite": "6.4.3",
      "ws@>=8.0.0 <8.21.0": "8.21.0"
    }
  }
}
