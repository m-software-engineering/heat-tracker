{
  "name": "@m-software-engineering/heat-collector",
  "version": "0.4.0",
  "description": "Collector server for heat-tracker sessions and events",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m-software-engineering/heat-tracker.git",
    "directory": "packages/heat-collector"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts src/server.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts src/cli.ts src/server.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run && corepack pnpm test:dist",
    "test:coverage": "vitest run --coverage && corepack pnpm test:dist",
    "test:dist": "corepack pnpm build && node scripts/distribution-smoke.mjs",
    "test:golden": "vitest run --no-file-parallelism src/heatmap.golden.test.ts src/heatmap-rollup-safety.test.ts src/pages.db.test.ts",
    "bench:heatmap": "node bench/heatmap-bench.mjs",
    "bench:pages": "node bench/pages-bench.mjs",
    "pack:check": "publint --pack npm && attw --pack . && api-extractor run --verbose",
    "api:check": "api-extractor run --verbose",
    "api:local": "api-extractor run --local --verbose"
  },
  "bin": {
    "heat-collector": "./dist/server.cjs",
    "heat-collector-migrate": "./dist/cli.cjs"
  },
  "dependencies": {
    "@m-software-engineering/heat-errors": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.2",
    "zod": "^3.24.2"
  },
  "peerDependencies": {
    "pg": "^8.12.0",
    "mysql2": "^3.23.1",
    "better-sqlite3": "^11.5.0 || ^12.0.0 || ^13.0.0",
    "mongodb": "^6.10.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.16.5",
    "@types/pg": "^8.11.8",
    "@types/supertest": "^2.0.16",
    "@vitest/coverage-v8": "4.1.12",
    "better-sqlite3": "^13.0.3",
    "supertest": "^6.3.4",
    "typescript": "^5.5.4",
    "vitest": "4.1.12",
    "mongodb": "^6.10.0"
  }
}
