{
  "name": "@m-software-engineering/heat-collector",
  "version": "0.3.7",
  "description": "Collector server for heat-tracker sessions and events",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m-software-engineering/heat-tracker.git",
    "directory": "packages/heat-collector"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts src/cli.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run && corepack pnpm test:dist",
    "test:coverage": "vitest run --coverage && corepack pnpm test:dist",
    "test:dist": "corepack pnpm build && node scripts/distribution-smoke.mjs",
    "pack:check": "publint --pack npm && attw --pack . && api-extractor run --verbose",
    "api:check": "api-extractor run --verbose",
    "api:local": "api-extractor run --local --verbose"
  },
  "bin": {
    "heat-collector-migrate": "./dist/cli.cjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.41.0",
    "express": "^4.19.2",
    "zod": "^3.24.2"
  },
  "peerDependencies": {
    "pg": "^8.12.0",
    "mysql2": "^3.10.2",
    "better-sqlite3": "^11.5.0",
    "mongodb": "^6.10.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/better-sqlite3": "^7.6.9",
    "@types/node": "^20.16.5",
    "@types/pg": "^8.11.8",
    "@types/supertest": "^2.0.16",
    "@vitest/coverage-v8": "^1.6.0",
    "better-sqlite3": "^11.5.0",
    "supertest": "^6.3.4",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0",
    "mongodb": "^6.10.0"
  }
}
